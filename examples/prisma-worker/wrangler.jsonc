{
  "name": "prisma-worker",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],

  // Hyperdrive binding - used in production
  // For local development, set CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE in .env
  // See: https://github.com/cloudflare/workers-sdk/issues/8157
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "6f4d2f22face49dc86c8988d95cdb0f3"
    }
  ],

  // For local development, use .dev.vars file instead
  // Production connection string (for Hyperdrive) - use your Supabase connection pooling URL:
  // postgres://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres
}

