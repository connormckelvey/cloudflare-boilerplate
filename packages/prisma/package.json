{
  "name": "@cloudflare-boilerplate/prisma",
  "version": "0.1.0",
  "description": "A reusable library for Prisma + Hyperdrive + Supabase integration in Cloudflare Workers",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "require": "./dist/types.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "cloudflare",
    "workers",
    "prisma",
    "hyperdrive",
    "supabase",
    "postgresql",
    "database",
    "orm"
  ],
  "author": "",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.2.0"
  },
  "peerDependencies": {
    "@prisma/client": "^7.2.0",
    "prisma": "^7.2.0"
  },
  "devDependencies": {
    "@prisma/client": "^7.2.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.9.0"
  }
}

